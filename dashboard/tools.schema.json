                  "description": "ISO 8601 expiry timestamp (auto-swept when past)."
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "Set an auto-expiry, or null to pin (clear the flag)."
        }
      },
      "additionalProperties": false
    }
  },
