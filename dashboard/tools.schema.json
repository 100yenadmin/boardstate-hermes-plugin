      ],
      "properties": {
        "order": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Tab slug."
          }
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "boardstate_widget_add",
    "description": "Add a widget to a tab. Grid x+w must fit within the 12-column dashboard grid. Call boardstate_workspace_get first when you need the current document.",
    "inputSchema": {
      "type": "object",
      "required": [
        "tab",
        "kind",
        "grid"
      ],
      "properties": {
        "tab": {
          "type": "string",
          "description": "Target tab slug."
        },
        "id": {
          "type": "string",
          "description": "Optional unique widget id."
        },
        "kind": {
          "type": "string",
          "description": "builtin:<name> or custom:<name>."
        },
        "title": {
          "type": "string",
          "description": "Widget title."
        },
        "grid": {
          "type": "object",
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 11,
              "description": "Grid x column, 0-11."
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 499,
              "description": "Grid row, 0-499."
            },
            "w": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12,
              "description": "Grid width, 1-12."
            },
            "h": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "description": "Grid height, 1-20."
            }
          },
          "additionalProperties": false
        },
        "collapsed": {
          "type": "boolean",
          "description": "Initial collapsed state."
        },
        "hidden": {
          "type": "boolean",
          "description": "Initial hidden state."
        },
        "bindings": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "source",
                    "method"
                  ],
                  "properties": {
                    "source": {
                      "type": "string",
                      "const": "rpc"
                    },
                    "method": {
                      "type": "string",
                      "description": "Allowlisted read method."
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "source",
                    "path"
                  ],
                  "properties": {
                    "source": {
                      "type": "string",
                      "const": "file"
                    },
                    "path": {
                      "type": "string",
                      "description": "Relative path under dashboard/data."
                    },
                    "pointer": {
                      "type": "string",
                      "description": "Optional JSON pointer."
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "source",
                    "value"
                  ],
                  "properties": {
                    "source": {
                      "type": "string",
                      "const": "static"
                    },
                    "value": {
                      "description": "JSON-compatible value."
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "description": "Widget binding map keyed by binding id."
        },
        "props": {
          "description": "JSON-compatible value."
        },
        "ephemeral": {
          "type": "object",
          "required": [
            "expiresAt"
          ],
          "properties": {
            "expiresAt": {
              "type": "string",
              "description": "ISO 8601 expiry timestamp (auto-swept when past)."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
