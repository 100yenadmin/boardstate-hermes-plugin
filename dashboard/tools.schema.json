[
  {
    "name": "boardstate_workspace_get",
    "description": "Read the full dashboard workspace document so an agent can diff before mutating it.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "boardstate_tab_create",
    "description": "Create a dashboard tab. Slugs are lowercase letters, digits, and dashes, max 40 chars. Call boardstate_workspace_get first when you need the current document.",
    "inputSchema": {
      "type": "object",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "Tab title, 1-80 chars."
        },
        "slug": {
          "type": "string",
          "description": "Optional tab slug."
        },
        "icon": {
          "type": "string",
          "description": "Optional icon name."
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "boardstate_tab_update",
    "description": "Update a dashboard tab title, icon, hidden state, or layout. Call boardstate_workspace_get first when you need the current document.",
    "inputSchema": {
      "type": "object",
      "required": [
        "slug"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "description": "Tab slug."
        },
        "title": {
          "type": "string",
          "description": "New title."
        },
        "icon": {
          "type": "string",
          "description": "New icon."
        },
        "hidden": {
          "type": "boolean",
          "description": "Hide or show the tab."
        },
        "layout": {
          "anyOf": [
            {
              "type": "string",
              "const": "grid"
            },
            {
              "type": "string",
              "const": "full"
            }
          ],
          "description": "Content layout: \"grid\" (default) or \"full\" (single full-bleed widget)."
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "boardstate_tab_delete",
